# Firebase Console > Project settings > Your apps > Web app > SDK configuration.
# These are public client identifiers, not service-account credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: true opens the separate local demo instead of real accounts.
# Restart Expo after changing this value.
EXPO_PUBLIC_CLEANTRACK_DEMO=false

# EAS project UUID from your Expo project. Needed for native push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
# EXPO_ACCESS_TOKEN belongs only in the owner worker environment when Expo push security is enabled.
# Never use an EXPO_PUBLIC variable for an owner access token.
