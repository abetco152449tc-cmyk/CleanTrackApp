{
  "expo": {
    "name": "CleanTrack",
    "slug": "CleanTrackApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cleantrack-icon.png",
    "scheme": "cleantrackapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/cleantrack-icon.png",
      "bundleIdentifier": "com.cleantrack.community"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cleantrack-foreground.png",
        "backgroundColor": "#087f5b"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cleantrack.community"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/cleantrack-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087f5b",
          "image": "./assets/images/cleantrack-foreground.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to include in your garbage report.",
          "cameraPermission": "Take a photo of waste for your garbage report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tag your garbage report with its location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
