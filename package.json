{
  "name": "cleantrackapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^15.31.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "export:all": "expo export --platform all",
    "format": "prettier --write src app.config.ts",
    "test:e2e": "playwright test",
    "test:auth": "firebase emulators:exec --project demo-cleantrack --only auth,firestore \"playwright test --config playwright.firebase.config.ts\"",
    "test:rules": "firebase emulators:exec --project demo-cleantrack --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "firebase:login": "firebase login",
    "firebase:check": "node scripts/firebase-readiness.cjs",
    "firebase:admin": "node scripts/bootstrap-admin.cjs",
    "firebase:deploy": "firebase deploy --project cleantrack-e62a9 --only firestore:rules,firestore:indexes",
    "start:go": "expo start --go",
    "test:location": "node --test tests/report-location.test.cjs",
    "test:unit": "node --test tests/report-location.test.cjs tests/location-map.test.cjs tests/report-pages.test.cjs tests/maintenance.test.mjs",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "notifications:worker": "node scripts/push-worker.mjs",
    "photos:cleanup": "node scripts/cleanup-photos.mjs",
    "test:maintenance": "node --test tests/maintenance.test.mjs"
  },
  "private": true
}
